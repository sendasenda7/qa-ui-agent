import { test } from "node:test";
import assert from "node:assert/strict";
import { extractTextsToVerify, stepsMentionText } from "../src/ticket-texts.js";
import { addMissingTextChecks, generateScenario, NO_CHECK_WARNING } from "../src/planner.js";

// --- extractTextsToVerify -------------------------------------------------------------------

test("extrait un texte exact que le ticket demande de voir s'afficher", () => {
  assert.deepEqual(
    extractTextsToVerify("Vérifier que le texte exact « Bienvenue chez Mars » est visible sur la page."),
    ["Bienvenue chez Mars"]
  );
  assert.deepEqual(
    extractTextsToVerify("Cliquer sur Envoyer puis vérifier que le message « Merci pour votre envoi » s'affiche."),
    ["Merci pour votre envoi"]
  );
});

test("accepte les guillemets français, typographiques et droits", () => {
  assert.deepEqual(extractTextsToVerify('Vérifier que le texte "Bonjour" est affiché.'), ["Bonjour"]);
  assert.deepEqual(extractTextsToVerify("Vérifier que le titre “Mon compte” est visible."), ["Mon compte"]);
});

test("ignore les libellés d'éléments : ils ont déjà leur propre étape", () => {
  assert.deepEqual(extractTextsToVerify("Vérifier que le bouton « Se connecter » est visible dans l'en-tête."), []);
  assert.deepEqual(extractTextsToVerify("Cliquer sur « Je suis une Association », puis sur « Continuer »."), []);
  assert.deepEqual(extractTextsToVerify("Vérifier que le lien « Mot de passe oublié » est visible."), []);
});

test("ignore les adresses et les valeurs à saisir", () => {
  assert.deepEqual(extractTextsToVerify("Vérifier que l'adresse de la page contient « /association »."), []);
  assert.deepEqual(extractTextsToVerify("Saisir « test@exemple.tn » dans l'email."), []);
});

test("ignore une citation sans rapport avec un affichage", () => {
  assert.deepEqual(extractTextsToVerify("Ouvrir la page puis choisir « Donateur »."), []);
});

test("écarte un texte trop court, trop long ou contenant un guillemet droit ou un antislash", () => {
  assert.deepEqual(extractTextsToVerify("Vérifier que le texte « A » est visible."), []);
  assert.deepEqual(extractTextsToVerify(`Vérifier que le texte « ${"x".repeat(121)} » est visible.`), []);
  assert.deepEqual(extractTextsToVerify('Vérifier que le texte « Il a dit "oui" » est visible.'), []);
  assert.deepEqual(extractTextsToVerify("Vérifier que le texte « a\\b » est visible."), []);
});

test("ne renvoie chaque texte qu'une fois, dans l'ordre du ticket", () => {
  assert.deepEqual(
    extractTextsToVerify(
      "Vérifier que le message « Succès » s'affiche, puis le titre « Tableau de bord » est visible, et encore le message « succès »."
    ),
    ["Succès", "Tableau de bord"]
  );
});

test("ticket vide ou non textuel : aucun texte", () => {
  assert.deepEqual(extractTextsToVerify(""), []);
  assert.deepEqual(extractTextsToVerify(undefined), []);
  assert.deepEqual(extractTextsToVerify(42), []);
});

// --- stepsMentionText -----------------------------------------------------------------------

test("stepsMentionText : un sélecteur ou une valeur qui contient le texte compte, pas la description ni navigate", () => {
  const steps = [
    { type: "navigate", selector: null, value: "https://x.test/Bonjour", description: "Ouvrir" },
    { type: "click", selector: 'role=button[name="Valider"]', value: null, description: "Cliquer sur Merci" },
    { type: "assert_text", selector: "h1", value: "Tableau de bord", description: "Titre" },
  ];
  assert.equal(stepsMentionText(steps, "valider"), true);
  assert.equal(stepsMentionText(steps, "Tableau  de BORD"), true);
  assert.equal(stepsMentionText(steps, "Bonjour"), false);
  assert.equal(stepsMentionText(steps, "Merci"), false);
});

// --- addMissingTextChecks -------------------------------------------------------------------

const baseScenario = () => ({
  ticketSummary: "t",
  warnings: [],
  confidence: 100,
  steps: [
    { type: "navigate", selector: null, value: null, description: "Ouvrir la page", selectorValid: true },
    { type: "assert_visible", selector: "#ok", value: null, description: "Bouton", selectorValid: true },
  ],
});

test("cas réel : « Bienvenue chez Mars » absent du scénario -> étape assert_visible ajoutée à la fin", () => {
  const result = addMissingTextChecks(
    baseScenario(),
    "Vérifier que le texte exact « Bienvenue chez Mars » est visible sur la page."
  );
  assert.equal(result.steps.length, 3);
  assert.deepEqual(result.steps[2], {
    type: "assert_visible",
    selector: 'text="Bienvenue chez Mars"',
    value: null,
    description: "Vérifier que le texte « Bienvenue chez Mars » s'affiche",
    selectorValid: true,
    selectorKind: "dynamic",
  });
  assert.equal(result.warnings.length, 1);
  assert.match(result.warnings[0], /Bienvenue chez Mars/);
  assert.equal(result.confidence, 85);
});

test("remplace l'avertissement de l'IA qui disait le texte invérifiable (pas de double pénalité)", () => {
  const scenario = {
    ...baseScenario(),
    warnings: [
      "Le texte exact « Bienvenue chez Mars » n'est pas présent dans la liste des textes visibles fournie, impossible de le vérifier.",
      "Un autre avertissement sans rapport.",
    ],
  };
  const result = addMissingTextChecks(scenario, "Vérifier que le texte « Bienvenue chez Mars » est visible.");
  assert.equal(result.warnings.length, 2);
  assert.ok(!result.warnings.some((w) => /impossible de le vérifier/.test(w)));
  assert.ok(result.warnings.includes("Un autre avertissement sans rapport."));
});

test("ne fait rien quand une étape cible déjà le texte", () => {
  const scenario = {
    ...baseScenario(),
    steps: [
      ...baseScenario().steps,
      { type: "assert_visible", selector: 'text="Bienvenue chez Mars"', value: null, description: "x", selectorValid: true },
    ],
  };
  const result = addMissingTextChecks(scenario, "Vérifier que le texte « Bienvenue chez Mars » est visible.");
  assert.equal(result, scenario);
});

test("ne fait rien quand le ticket ne cite aucun texte à vérifier", () => {
  const scenario = baseScenario();
  assert.equal(addMissingTextChecks(scenario, "Vérifier que le bouton « Continuer » est visible."), scenario);
});

test("ne fait rien sur un scénario vide : l'erreur « aucune étape » reste visible", () => {
  const scenario = { ticketSummary: "t", warnings: [], confidence: 0, steps: [] };
  assert.equal(addMissingTextChecks(scenario, "Vérifier que le texte « Bonjour » est visible."), scenario);
});

test("un scénario qui ne vérifiait rien en vérifie maintenant : l'avertissement « aucune vérification » disparaît", () => {
  const scenario = {
    ticketSummary: "t",
    warnings: [NO_CHECK_WARNING],
    confidence: 15,
    steps: [{ type: "navigate", selector: null, value: null, description: "Ouvrir la page", selectorValid: true }],
  };
  const result = addMissingTextChecks(scenario, "Vérifier que le texte « Bonjour » est visible.");
  assert.ok(!result.warnings.includes(NO_CHECK_WARNING));
  assert.equal(result.warnings.length, 1);
  assert.equal(result.confidence, 85);
});

test("plusieurs textes manquants : une étape et un avertissement chacun, dans l'ordre", () => {
  const result = addMissingTextChecks(
    baseScenario(),
    "Vérifier que le titre « Alpha » est visible puis que le message « Beta » s'affiche."
  );
  assert.deepEqual(
    result.steps.slice(2).map((s) => s.selector),
    ['text="Alpha"', 'text="Beta"']
  );
  assert.equal(result.warnings.length, 2);
});

// --- generateScenario (IA simulée) ----------------------------------------------------------

function groqResponse(content) {
  return {
    ok: true,
    status: 200,
    json: async () => ({ choices: [{ message: { content } }] }),
    text: async () => "",
    headers: { get: () => null },
  };
}

test("generateScenario : l'IA renonce au texte du ticket -> la vérification est ajoutée et échouera si le texte est absent", async () => {
  const originalFetch = global.fetch;
  const originalKey = process.env.GROQ_API_KEY;
  process.env.GROQ_API_KEY = "fake-key";
  global.fetch = async () =>
    groqResponse(
      JSON.stringify({
        ticketSummary: "Vérifier un texte",
        warnings: ["Le texte exact « Bienvenue chez Mars » n'est pas présent dans la liste, impossible de le vérifier."],
        steps: [
          { type: "navigate", selector: null, value: null, description: "Ouvrir la page" },
          { type: "assert_visible", selector: "#login", description: "Formulaire visible" },
        ],
      })
    );
  try {
    const scenario = await generateScenario(
      "Vérifier que le texte exact « Bienvenue chez Mars » est visible sur la page.",
      { url: "https://example.test", elements: [{ selector: "#login", tag: "form" }] }
    );
    const last = scenario.steps.at(-1);
    assert.equal(last.type, "assert_visible");
    assert.equal(last.selector, 'text="Bienvenue chez Mars"');
    assert.equal(last.selectorKind, "dynamic");
    assert.equal(last.selectorValid, true);
    assert.ok(!scenario.warnings.some((w) => /impossible de le vérifier/.test(w)));
    assert.equal(scenario.confidence, 85);
  } finally {
    global.fetch = originalFetch;
    process.env.GROQ_API_KEY = originalKey;
  }
});
