GROQ_API_KEY=colle_ta_clé_ici
# Optionnel — modèle Groq à utiliser. Groq déprécie régulièrement ses modèles ;
# si tu obtiens une erreur "model_not_found", vérifie la liste à jour sur
# https://console.groq.com/docs/models et mets à jour cette ligne.
GROQ_MODEL=openai/gpt-oss-120b

# Mot de passe partagé par l'équipe pour accéder à l'outil.
AUTH_PASSWORD=choisis_un_mot_de_passe

# Clé secrète pour signer les tokens de session — une longue chaîne aléatoire,
# jamais devinable. Génère-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=colle_une_valeur_aleatoire_generee_ici

# ---- Optionnel (voir le README, section Configuration) ----
# Sites que le serveur a le droit de tester (virgules, jokers *. acceptés). Recommandé en production.
# ALLOWED_TARGET_HOSTS=staging.helpify.tn,*.devwise.tn
# Autorise localhost / réseau privé comme cible (développement uniquement).
# ALLOW_PRIVATE_TARGETS=true
# Origines autorisées à appeler l'API depuis un navigateur (le frontend déployé).
# CORS_ORIGIN=http://localhost:5173
# Nombre de reverse proxys devant l'API (Nginx, Render...).
# TRUST_PROXY=1
# JWT_LIFETIME=7d
# MAX_CONCURRENT_RUNS=2
# VISUAL_DIFF_THRESHOLD_PERCENT=0.5
# AR_TOGGLE_KEYWORDS=tounsi
# I18N_IGNORE_TEXTS=Helpify,Espoir
# Attente max (ms) que le réseau se calme après le chargement d'une page. Les sites avec carrousel,
# analytics ou websocket ne se calment jamais : on continue alors au bout de ce délai.
# NETWORK_SETTLE_TIMEOUT_MS=5000
# Attente max (ms) que l'appli (Angular, React...) affiche son contenu avant analyse/capture
# RENDER_TIMEOUT_MS=10000
# Relances automatiques d'une étape en échec (0 à 2, défaut 1). Une étape qui ne réussit qu'à la
# relance rend le test « instable ». 0 désactive les relances.
# STEP_RETRIES=1
# Attente max (ms) lors d'une relance : plus courte que la première tentative, car elle sert à
# rattraper un état passager, pas à attendre à nouveau aussi longtemps.
# STEP_RETRY_TIMEOUT_MS=3000

# Nettoyage automatique : les captures et traces de plus de RETENTION_DAYS jours sont supprimées (0 = jamais),
# sauf celles des RETENTION_KEEP_RUNS runs les plus récents. Les résultats (historique, tendances) sont gardés.
# RETENTION_DAYS=30
# RETENTION_KEEP_RUNS=50

# Compte de TEST (staging uniquement) que l'agent peut utiliser pour se connecter. Les valeurs ne sont jamais
# montrées à l'IA ni écrites dans les rapports (voir « Se connecter avec un compte de test » dans le README).
# Pas de commentaire sur la même ligne qu'une valeur.
# QA_SECRET_ASSOCIATION=
# QA_SECRET_EMAIL=
# QA_SECRET_PASSWORD=
